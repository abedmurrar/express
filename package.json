{
  "name": "express",
  "description": "Fast, unopinionated, minimalist web framework",
  "version": "5.3.0",
  "author": "TJ Holowaychuk <tj@vision-media.ca>",
  "contributors": [
    "Aaron Heckmann <aaron.heckmann+github@gmail.com>",
    "Ciaran Jessup <ciaranj@gmail.com>",
    "Douglas Christopher Wilson <doug@somethingdoug.com>",
    "Guillermo Rauch <rauchg@gmail.com>",
    "Jonathan Ong <me@jongleberry.com>",
    "Roman Shtylman <shtylman+expressjs@gmail.com>",
    "Young Jae Sim <hanul@hanul.me>"
  ],
  "license": "MIT",
  "repository": "abedmurrar/express",
  "homepage": "https://github.com/abedmurrar/express#readme",
  "keywords": [
    "express",
    "framework",
    "sinatra",
    "web",
    "http",
    "rest",
    "restful",
    "router",
    "app",
    "api"
  ],
  "main": "index.js",
  "types": "typings/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./typings/index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./typings/index.d.ts",
        "default": "./index.js"
      }
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "bytes": "^3.1.2",
    "content-disposition": "^2.0.1",
    "content-type": "^2.1.0",
    "cookie": "^0.7.1",
    "cookie-signature": "^1.2.2",
    "debug": "^4.4.0",
    "depd": "^2.0.0",
    "encodeurl": "^2.0.0",
    "escape-html": "^1.0.3",
    "etag": "^1.8.1",
    "finalhandler": "^2.1.1",
    "fresh": "^2.0.0",
    "http-errors": "^2.0.1",
    "iconv-lite": "^0.7.3",
    "is-promise": "^4.0.0",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "on-finished": "^2.4.2",
    "parseurl": "^1.3.3",
    "path-to-regexp": "^8.0.0",
    "proxy-addr": "^2.0.8",
    "range-parser": "^1.2.1",
    "raw-body": "^3.0.2",
    "statuses": "^2.0.2",
    "type-is": "^2.1.0",
    "vary": "^1.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.7",
    "@types/bytes": "^3.1.5",
    "@types/content-type": "^1.1.9",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/debug": "^4.1.13",
    "@types/depd": "^1.1.38",
    "@types/encodeurl": "^1.0.3",
    "@types/escape-html": "^1.0.4",
    "@types/etag": "^1.8.4",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/finalhandler": "^1.2.4",
    "@types/fresh": "^0.5.3",
    "@types/http-errors": "^2.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.5",
    "@types/on-finished": "^2.3.5",
    "@types/parseurl": "^1.3.3",
    "@types/proxy-addr": "^2.0.3",
    "@types/range-parser": "^1.2.7",
    "@types/statuses": "^2.0.6",
    "@types/type-is": "^1.6.7",
    "@types/vary": "^1.1.3",
    "after": "0.8.2",
    "body-parser": "2.4.0",
    "c8": "^12.0.0",
    "compression": "^1.8.2",
    "connect-redis": "^8.0.1",
    "cookie-parser": "1.4.7",
    "cookie-session": "2.1.1",
    "cors": "^2.8.6",
    "ejs": "^3.1.10",
    "express-baseline": "npm:express@5.3.0",
    "express-basic-auth": "^1.2.1",
    "express-fileupload": "^1.6.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.1",
    "fast-check": "^4.10.2",
    "hbs": "4.4.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "http-proxy-middleware": "^4.2.1",
    "marked": "^15.0.3",
    "method-override": "3.0.0",
    "morgan": "1.12.1",
    "multer": "^2.5.0",
    "negotiator": "1.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pbkdf2-password": "1.2.1",
    "qs": "6.17.1",
    "run-series": "^1.1.9",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vhost": "~3.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "files": [
    "LICENSE",
    "Readme.md",
    "index.js",
    "index.mjs",
    "lib/**/*.js",
    "lib/**/LICENSE",
    "typings/*.d.ts",
    "typings/*.d.mts"
  ],
  "scripts": {
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "npm run build && vitest run",
    "test-ci": "npm run build && c8 --reporter=lcovonly --reporter=text vitest run && node scripts/check-coverage-files.js",
    "test-cov": "npm run build && c8 --reporter=html --reporter=text vitest run",
    "test-tap": "npm run build && vitest run --reporter=tap",
    "bench:install": "npm --prefix benchmarks/compare install",
    "bench": "node benchmarks/compare/run.ts",
    "test:ecosystem-suites": "node scripts/ecosystem-suites.js",
    "release": "node scripts/release.js",
    "build": "node scripts/build.js",
    "test:types:drift": "npm run build && node scripts/check-types-drift.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:types": "tsc -p test/types/tsconfig.json && tsc -p test/types/tsconfig.loose.json && tsc -p test/types/tsconfig.dt.json && node scripts/check-type-size.js",
    "test:types:ts5:install": "npm --prefix test/types/ts5 install --ignore-scripts --no-package-lock",
    "test:types:ts5": "node scripts/type-tests-ts5.js",
    "attw": "attw --pack ."
  },
  "bugs": {
    "url": "https://github.com/abedmurrar/express/issues"
  },
  "overrides": {
    "express-baseline": {
      ".": "npm:express@5.3.0",
      "accepts": "2.0.0",
      "body-parser": "2.4.0",
      "content-disposition": "2.0.1",
      "content-type": "2.1.0",
      "cookie": "0.7.2",
      "cookie-signature": "1.2.2",
      "debug": "4.4.3",
      "depd": "2.0.0",
      "encodeurl": "2.0.3",
      "escape-html": "1.0.3",
      "etag": "1.8.1",
      "finalhandler": "2.1.1",
      "fresh": "2.0.0",
      "http-errors": "2.0.1",
      "merge-descriptors": "2.0.0",
      "mime-types": "3.0.2",
      "on-finished": "2.4.2",
      "once": "1.4.0",
      "parseurl": "1.3.3",
      "proxy-addr": "2.0.8",
      "qs": "6.17.1",
      "range-parser": "1.3.0",
      "router": "2.2.0",
      "send": "1.2.1",
      "serve-static": "2.2.1",
      "statuses": "2.0.2",
      "type-is": "2.1.0",
      "vary": "1.1.2"
    }
  }
}
