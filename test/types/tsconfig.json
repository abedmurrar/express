{
  // Strict type tests: every strict option, Node's module resolution (so
  // `express` resolves through package.json `exports`, as the package's own
  // name), and the published declarations checked too (no skipLibCheck).
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,
    "isolatedModules": true,
    "skipLibCheck": false,
    "noEmit": true,
    // How an app that imports `express-serve-static-core` uses these types
    // instead of @types/express-serve-static-core.
    "paths": {
      "express-serve-static-core": ["../../typings/core.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"]
}
