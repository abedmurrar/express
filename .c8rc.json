{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "index.js",
    "index.mjs",
    "lib/**/*.js",
    "src/**/*.js",
    "src/**/*.ts"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "text"
  ],
  "check-coverage": true,
  "lines": 100,
  "branches": 100,
  "functions": 100,
  "statements": 100
}
